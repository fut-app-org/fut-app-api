# PostgreSQL
POSTGRES_USER=futapp
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=futapp

# Assinatura das sessoes. Gere com: openssl rand -hex 32
JWT_SECRET=

# Primeiro administrador. Sem senha, a API gera uma senha aleatoria no primeiro start.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@futdarapaziada.local
SEED_ADMIN_PASSWORD=

# Mercado Pago. Use as credenciais de teste durante o desenvolvimento.
# Nunca exponha o Access Token no frontend ou o envie ao repositório.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Ative apenas no sandbox. O e-mail de teste exigido pelo Mercado Pago Ã© configurado pela API.
MERCADO_PAGO_TEST_MODE=false
