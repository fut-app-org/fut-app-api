# PostgreSQL
POSTGRES_USER=futapp
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=futapp

# Assinatura das sessoes. Gere com: openssl rand -hex 32
JWT_SECRET=

# Primeiro administrador. Sem senha, a API gera uma senha aleatoria no primeiro start.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@futdarapaziada.local
SEED_ADMIN_PASSWORD=
